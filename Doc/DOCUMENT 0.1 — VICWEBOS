/* ... resto de estilos usando var(--xx, fallback) */

─────── herramientas/{appId}/script.js ───────
'use strict';

const MENSAJE_TEMA = 'vicwebos_tema_cambio';

const API = () => window.parent.__vicwebos || null;
const BD  = () => window.parent.ConfigBD || null;
const MH  = () => window.parent.MasterHad || null;

// --- Herencia de tema (verbatim, ver sección 4.4) ---
function aplicarTemaDelPadre() { ... }

window.addEventListener('message', (e) => {
    if (e.data && e.data.type === MENSAJE_TEMA) aplicarTemaDelPadre();
});

// --- Lógica de la app ---
async function inicializar() {
    aplicarTemaDelPadre();
    // ... resto
    if (window.lucide) window.lucide.createIcons();
}

document.addEventListener('DOMContentLoaded', inicializar);


>>> 5.4 — ANATOMÍA COMPLETA DE UNA APP

Toda app bien hecha tiene estas 7 secciones en su script.js:

1. CONFIGURACIÓN
   - Constantes (paths, límites, precios)
   - MENSAJE_TEMA

2. FUNCIONES DE ACCESO A API
   const API = () => window.parent.__vicwebos || null;
   const BD  = () => window.parent.ConfigBD || null;
   const MH  = () => window.parent.MasterHad || null;

3. HERENCIA DE TEMA
   - aplicarTemaDelPadre()
   - window.addEventListener('message', ...)

4. HELPERS LOCALES
   - toast(), escapar(), formatearFecha(), etc.
   - Cada app define los suyos.

5. PERSISTENCIA
   - cargar() → lee el JSON del repo de datos
   - guardar() → escribe el JSON

6. RENDER
   - render() → pinta toda la UI desde el estado
   - Se llama cada vez que cambia el estado

7. INICIALIZACIÓN
   - document.addEventListener('DOMContentLoaded', inicializar)
   - En inicializar(): aplicarTemaDelPadre, cargar usuario, cargar datos,
     render, wire eventos, lucide.createIcons()


>>> 5.5 — REGLAS VISUALES PARA APPS

  ● Colores: NUNCA hardcodear. SIEMPRE var(--xx, fallback).
    El fallback debe ser el color del tema violeta por defecto.
    Ejemplo: background: var(--violet-500, #8B5CF6);

  ● Iconos: SIEMPRE Lucide. NUNCA emojis.
    <i data-lucide="calculator"></i>

  ● Layout: PC → ancho máximo razonable, grid si aplica.
            Móvil → apilado, sin scroll horizontal.

  ● Espaciado: usar múltiplos de 4 (4, 8, 12, 16, 20, 24, 32).

  ● Radios: usar variables (--r-sm, --r-md, --r-lg, --r-xl, --r-full).

  ● Sombras: usar variables (--shadow-xs ... --shadow-xl).

  ● Tipografía: Nunito. Importarla con <link> de Google Fonts.
    Tamaños típicos: 22px título, 14px body, 12px secondary, 10px label.

  ● Botones:
    - Principal: fondo --accent-gradient-hover, texto blanco, sombra --accent-shadow.
    - Secundario: fondo --white, borde --border, texto --gray-700.

  ● Inputs: fondo --white, borde 1.5px --border, focus border --violet-400 +
    box-shadow --shadow-glow.

  ● Toasts: posición fixed bottom, bg --gray-900, texto blanco, border-radius
    999px, transición suave.

  ● Modales: fondo overlay rgba(24,24,27,0.5) + backdrop-filter blur(8px).
    Card bg --white, border-radius --r-xl.

  ● Empty state: icono Lucide grande + título + subtítulo + botón de acción.


