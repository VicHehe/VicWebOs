  const _locks = new Set();

  async function _conLock(clave, fn) {
      if (_locks.has(clave)) {
          throw new Error('Operación en curso. Espera un momento.');
      }
      _locks.add(clave);
      try {
          return await fn();
      } finally {
          _locks.delete(clave);
      }
  }

