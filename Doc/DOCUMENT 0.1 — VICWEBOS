>>> 8.1 — CONSTANTES

  ESPACIO_INICIAL          = 50     (espacio gratis al crear cuenta)
  ESPACIO_POR_COMPRA       = 12     (espacio ganado al comprar)
  COSTO_COMPRA_ESPACIO     = 2500   (monedas por compra de espacio)
  MONEDAS_INICIALES        = 0
  MAX_WIDGETS_ACTIVOS      = 3
